{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Pong 빌드 (gcc)",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O2",
                "-Wall",
                "-DPRED",
                "-o",
                "pong_game.exe",
                "pong_game.c",
                "ranking.c",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}